# Configurações para Ambiente de Desenvolvimento
NODE_ENV=development
REACT_APP_ENV=development

# URLs da API
REACT_APP_API_BASE_URL=http://localhost:3000
REACT_APP_SUPABASE_URL=your_dev_supabase_url
REACT_APP_SUPABASE_ANON_KEY=your_dev_supabase_anon_key

# Evolution API (Desenvolvimento)
REACT_APP_EVOLUTION_BASE_URL=your_dev_evolution_url
REACT_APP_EVOLUTION_API_KEY=your_dev_evolution_api_key
REACT_APP_EVOLUTION_INSTANCE_NAME=your_dev_instance_name
REACT_APP_EVOLUTION_PHONE_NUMBER=your_dev_phone_number

# Configurações de Debug
REACT_APP_DEBUG=true
REACT_APP_LOG_LEVEL=debug

# Porta do servidor
PORT=3000