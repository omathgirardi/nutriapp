# Configurações Base - Compartilhadas entre todos os ambientes
# Este arquivo contém configurações padrão que podem ser sobrescritas pelos arquivos específicos de ambiente

# Informações da aplicação
REACT_APP_NAME=NutriApp
REACT_APP_VERSION=1.0.0

# Configurações padrão
REACT_APP_DEFAULT_LANGUAGE=pt-BR
REACT_APP_TIMEZONE=America/Sao_Paulo

# Configurações de cache
REACT_APP_CACHE_DURATION=3600

# Configurações de upload
REACT_APP_MAX_FILE_SIZE=5242880
REACT_APP_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif

# Configurações de paginação
REACT_APP_DEFAULT_PAGE_SIZE=20
REACT_APP_MAX_PAGE_SIZE=100