{
  "version": 2,
  "name": "nutriapp",
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "."
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "env": {
    "NODE_ENV": "production",
    "REACT_APP_USE_MOCK_DATA": "false"
  },
  "functions": {
    "src/services/*.js": {
      "maxDuration": 30
    }
  }
}