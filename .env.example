# Arquivo de exemplo para configuração de ambiente
# Copie este arquivo e renomeie para .env.local ou .env.[ambiente]
# Substitua os valores pelos seus dados reais

# Ambiente
NODE_ENV=development
REACT_APP_ENV=development

# URLs da API
REACT_APP_API_BASE_URL=http://localhost:3000
REACT_APP_SUPABASE_URL=https://seu-projeto.supabase.co
REACT_APP_SUPABASE_ANON_KEY=sua_chave_anonima_aqui

# Evolution API
REACT_APP_EVOLUTION_BASE_URL=https://sua-evolution-api.com
REACT_APP_EVOLUTION_API_KEY=sua_chave_da_evolution_api
REACT_APP_EVOLUTION_INSTANCE_NAME=sua_instancia
REACT_APP_EVOLUTION_PHONE_NUMBER=5511999999999

# Configurações de Debug
REACT_APP_DEBUG=true
REACT_APP_LOG_LEVEL=debug

# Porta do servidor
PORT=3000

# Configurações específicas (opcional)
REACT_APP_MOCK_DATA=false
REACT_APP_TEST_MODE=false
REACT_APP_SECURE_MODE=false
REACT_APP_HTTPS_ONLY=false