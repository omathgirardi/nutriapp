# Configurações para Ambiente de Teste
NODE_ENV=test
REACT_APP_ENV=test

# URLs da API
REACT_APP_API_BASE_URL=http://localhost:3001
REACT_APP_SUPABASE_URL=your_test_supabase_url
REACT_APP_SUPABASE_ANON_KEY=your_test_supabase_anon_key

# Evolution API (Teste)
REACT_APP_EVOLUTION_BASE_URL=your_test_evolution_url
REACT_APP_EVOLUTION_API_KEY=your_test_evolution_api_key
REACT_APP_EVOLUTION_INSTANCE_NAME=your_test_instance_name
REACT_APP_EVOLUTION_PHONE_NUMBER=your_test_phone_number

# Configurações de Debug
REACT_APP_DEBUG=true
REACT_APP_LOG_LEVEL=info

# Porta do servidor
PORT=3001

# Configurações específicas de teste
REACT_APP_MOCK_DATA=true
REACT_APP_TEST_MODE=true