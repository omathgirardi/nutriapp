# Configurações para Ambiente de Produção
NODE_ENV=production
REACT_APP_ENV=production

# URLs da API
REACT_APP_API_BASE_URL=https://your-production-domain.com
REACT_APP_SUPABASE_URL=your_production_supabase_url
REACT_APP_SUPABASE_ANON_KEY=your_production_supabase_anon_key

# Evolution API (Produção)
REACT_APP_EVOLUTION_BASE_URL=your_production_evolution_url
REACT_APP_EVOLUTION_API_KEY=your_production_evolution_api_key
REACT_APP_EVOLUTION_INSTANCE_NAME=your_production_instance_name
REACT_APP_EVOLUTION_PHONE_NUMBER=your_production_phone_number

# Configurações de Debug
REACT_APP_DEBUG=false
REACT_APP_LOG_LEVEL=error

# Porta do servidor
PORT=8080

# Configurações de segurança
REACT_APP_SECURE_MODE=true
REACT_APP_HTTPS_ONLY=true